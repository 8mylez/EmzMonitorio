{
    "name": "emz/monitorio",
    "description": "Shopware 6 plugin that forwards selected Monolog log records and custom events to a Monitorio ingest endpoint.",
    "type": "shopware-platform-plugin",
    "version": "1.6.0",
    "license": "MIT",
    "authors": [
        {
            "name": "8mylez GmbH",
            "homepage": "https://8mylez.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "shopware/core": ">=6.5.0.0",
        "monolog/monolog": "^2.0 || ^3.0",
        "symfony/config": ">=5.4",
        "symfony/console": ">=5.4",
        "symfony/dependency-injection": ">=5.4",
        "symfony/http-client": ">=5.4",
        "symfony/http-kernel": ">=5.4",
        "symfony/messenger": ">=5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0"
    },
    "extra": {
        "shopware-plugin-class": "Emz\\Monitorio\\EmzMonitorio",
        "plugin-icon": "src/Resources/config/plugin.jpeg",
        "label": {
            "de-DE": "Monitorio Event Ingest",
            "en-GB": "Monitorio Event Ingest"
        },
        "copyright": "(c) by 8mylez GmbH",
        "description": {
            "de-DE": "Leitet Monolog-Logs und benutzerdefinierte Events regelbasiert an Monitorio weiter.",
            "en-GB": "Forwards Monolog logs and custom events to Monitorio based on configurable rules."
        },
        "manufacturerLink": {
            "de-DE": "https://store.shopware.com/8mylez.html",
            "en-GB": "https://store.shopware.com/en/8mylez.html"
        },
        "supportLink": {
            "de-DE": "https://8mylez.com",
            "en-GB": "https://8mylez.com"
        }
    },
    "autoload": {
        "psr-4": {
            "Emz\\Monitorio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emz\\Monitorio\\Tests\\": "tests/"
        }
    }
}
